---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import eartheners from '../assets/logos/eartheners-logo.png';
import unibrow from '../assets/logos/unibrow-logo.png';
import { site } from '../config';
---
<Base title="Partners" description="The partners of Chingkhei Hunba Polo Club for the 2026–27 season.">
  <section class="page-head">
    <div class="wrap">
      <h1>Partners</h1>
      <p>The businesses standing with the club for the 2026–27 season.</p>
    </div>
  </section>
  <section class="section section--sky">
    <div class="wrap">
      <div class="partner-cards">
        <article class="partner-card">
          <a class="logo" href="https://earthene.rs"><Image src={eartheners} alt="Eartheners" height={208} /></a>
          <h3>Eartheners</h3>
          <p>Rooftop and off-grid solar from Imphal. Season partner for 2026–27, supporting the team’s tournaments, practice and kit.</p>
          <p><a href="https://earthene.rs">earthene.rs</a></p>
        </article>
        <article class="partner-card">
          <a class="logo" href="https://unibrow.studio"><Image src={unibrow} alt="Unibrow Studio" height={208} /></a>
          <h3>Unibrow Studio</h3>
          <p>Content studio from Imphal. Season partner for 2026–27, looking after the club’s website, pages and match photography.</p>
          <p><a href="https://unibrow.studio">unibrow.studio</a></p>
        </article>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 style="margin-bottom:1rem">Partner with the club</h2>
      <p class="lede">The club welcomes businesses and organisations that want to support polo and the Manipuri pony. Partners are featured on this website and in the club’s stories and pages.</p>
      {site.email && <p><a class="btn" href={`mailto:${site.email}`}>Write to the club</a></p>}
    </div>
  </section>
</Base>
