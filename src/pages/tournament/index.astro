---
import Base from '../../layouts/Base.astro';
import fixture from '../../data/tournaments/hazari-2026.json';
import { render, todayIST, fmt, type Tournament } from '../../lib/tournament';

// The fixture is baked in at build time. Scores entered through /tournament/update/
// are fetched from /api/results when the page opens, so results go live without a build.
const t = fixture as Tournament;
const html = render(t, { today: todayIST(), team: '' });
const json = JSON.stringify(t).replace(/</g, '\\u003c');
---
<Base
  title={`${t.short} fixtures and results`}
  description={`Day-by-day fixtures and results of the ${t.name}, ${fmt(t.start)} to ${fmt(t.end)}, ${t.venue}.`}
>
  <section class="page-head tn-head">
    <div class="wrap">
      <p class="tn-eyebrow">{t.edition} · {t.organiser}</p>
      <h1>{t.titleLines.map((l) => <span>{l} </span>)}<span class="tn-yr">{t.year}</span></h1>
      <ul class="tn-facts">
        <li><b>{fmt(t.start)}</b> to <b>{fmt(t.end)}</b></li>
        <li>{t.venue}</li>
        <li>{new Set(t.matches.flatMap((m) => [m.a.team, m.b.team]).filter(Boolean)).size} teams · {t.matches.length} matches</li>
        <li>{t.report}</li>
      </ul>
    </div>
  </section>
  <div id="tn-root" data-slug={t.slug} set:html={html} />
  <script type="application/json" id="tn-fixture" set:html={json} />
</Base>

<script>
  import { render, merge, dayText, todayIST, type Tournament, type Live } from '../../lib/tournament';

  const root = document.getElementById('tn-root')!;
  const slug = root.dataset.slug!;
  const fixture: Tournament = JSON.parse(document.getElementById('tn-fixture')!.textContent || '{}');
  let live: Live | null = null;
  let team = '';
  try { team = localStorage.getItem(`tn-team-${slug}`) || ''; } catch {}

  const current = () => merge(fixture, live);

  function setHeaderOffset() {
    const h = document.querySelector('.site-header') as HTMLElement | null;
    document.documentElement.style.setProperty('--hdr-h', `${h ? h.offsetHeight : 81}px`);
  }

  let drawn = false;
  function draw() {
    const days = document.getElementById('tn-days');
    const keep = drawn && days ? days.scrollLeft : null;
    drawn = true;
    root.innerHTML = render(current(), { today: todayIST(), team });
    const nd = document.getElementById('tn-days');
    if (nd) {
      const tc = nd.querySelector('.today') as HTMLElement | null;
      if (keep !== null) nd.scrollLeft = keep;
      else if (tc) nd.scrollLeft = Math.max(0, tc.offsetLeft - nd.offsetLeft - 60);
    }
  }

  async function refresh() {
    try {
      const r = await fetch(`/api/results?t=${encodeURIComponent(slug)}`, { headers: { accept: 'application/json' } });
      if (!r.ok) return;
      const data = await r.json();
      if (data && data.matches) {
        const changed = JSON.stringify(data) !== JSON.stringify(live);
        live = data;
        if (changed) draw();
      }
    } catch { /* offline or function not available: the built-in results stay */ }
  }

  function setTeam(v: string) {
    team = v;
    try { localStorage.setItem(`tn-team-${slug}`, team); } catch {}
    draw();
    document.querySelector('.tn-strip')?.scrollIntoView({ block: 'start' });
  }

  root.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('[data-jump],[data-follow],[data-copy]') as HTMLElement | null;
    if (!el) return;
    if (el.dataset.jump !== undefined) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.getElementById(`d-${el.dataset.jump}`)?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    } else if (el.dataset.follow !== undefined) {
      setTeam(el.dataset.follow);
    } else if (el.dataset.copy) {
      const d = el.dataset.copy;
      const text = dayText(current(), d, team);
      const out = document.getElementById(`cp-${d}`);
      const done = (ok: boolean) => { if (out) out.textContent = ok ? 'Copied' : 'Could not copy'; };
      const fallback = () => {
        const ta = document.createElement('textarea');
        ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        let ok = false; try { ok = document.execCommand('copy'); } catch {}
        ta.remove(); done(ok);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(() => done(true), fallback); else fallback();
    }
  });
  root.addEventListener('change', (e) => {
    const el = e.target as HTMLSelectElement;
    if (el.id === 'tn-team') setTeam(el.value);
  });

  setHeaderOffset();
  window.addEventListener('resize', setHeaderOffset);
  draw();
  refresh();
  // Check for new scores every two minutes while the page is open and visible.
  setInterval(() => { if (document.visibilityState === 'visible') refresh(); }, 120_000);
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') refresh(); });
</script>
