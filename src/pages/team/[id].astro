---
import Base from '../../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import Lightbox from '../../components/Lightbox.astro';
import type { ImageMetadata } from 'astro';
import { players, type Player } from '../../data/players';

export function getStaticPaths() {
  const squad = players.filter((p) => p.show).sort((a, b) => Number(a.position) - Number(b.position));
  return squad.map((player, i) => ({
    params: { id: player.id },
    props: { player, prev: squad[i - 1] ?? null, next: squad[i + 1] ?? null },
  }));
}
interface Props { player: Player; prev: Player | null; next: Player | null }
const { player, prev, next } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/players/*.{jpg,jpeg,png,webp}', { eager: true });
const stem = (p: string) => p.split('/').pop()!.split('.')[0];
// Main photo: <id>.jpg. More photos: <id>-2.jpg, <id>-3.jpg … shown on this page only.
const photo = Object.entries(photos).find(([p]) => stem(p) === player.id)?.[1].default;
const extras = Object.entries(photos)
  .filter(([p]) => new RegExp(`^${player.id}-\\d+$`).test(stem(p)))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([p, m]) => ({ src: m.default, caption: player.photoCaptions?.[stem(p).split('-').pop()!] ?? '' }));
const full = async (src: ImageMetadata) => (await getImage({ src, width: Math.min(src.width, 1600), format: 'webp' })).src;
const mainFull = photo ? await full(photo) : null;
const extraItems = await Promise.all(extras.map(async (x) => ({ ...x, full: await full(x.src) })));
const facts = [
  { label: 'With the club', value: player.withClubSince },
  { label: 'Pony', value: player.pony },
  { label: 'Also rides', value: player.alsoRides },
].filter((f) => f.value);
const links = Object.entries(player.social).filter(([, url]) => url);
---
<Base title={player.name} description={`${player.name}, number ${player.position} for Chingkhei Hunba Polo Club in 2026–27.`}>
  <section class="player-hero">
    <div class="wrap">
      <div>
        <a class="back" href="/team/">The team</a>
        <h1>{player.name}<small>Number {player.position}, Chingkhei Hunba Polo Club, 2026–27{player.pressName && player.pressName !== player.short ? `. In match reports: ${player.pressName}` : ''}</small></h1>
      </div>
      <div class="num" aria-hidden="true">{player.position}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap profile">
      <div>
        {photo && mainFull && (
          <div data-lightbox class="player-photo">
            <a href={mainFull} data-caption={player.name}><Image src={photo} alt={player.name} widths={[500, 900]} sizes="(max-width: 820px) 100vw, 40vw" /></a>
          </div>
        )}
        {facts.length > 0 ? (
          <dl>
            {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
          </dl>
        ) : null}
        {links.length > 0 && (
          <p style="margin-top:1.5rem">{links.map(([k, url], i) => <>{i > 0 && ', '}<a href={url}>{k[0].toUpperCase() + k.slice(1)}</a></>)}</p>
        )}
      </div>
      <div>
        {player.inTheirWords && (
          <blockquote class="words"><p>“{player.inTheirWords}”</p></blockquote>
        )}
        {player.highlights.length > 0 && (<>
          <h2>On the field</h2>
          <ul class="highlights">
            {player.highlights.map((h) => (
              <li>
                <p>{h.text}</p>
                {h.source.url ? <a href={h.source.url} rel="noopener" target="_blank">{h.source.label}</a> : <span>{h.source.label}</span>}
              </li>
            ))}
          </ul>
        </>)}
        {extraItems.length > 0 && (
          <div class="player-extras" data-lightbox>
            {extraItems.map((x) => (
              <a href={x.full} data-caption={x.caption ? `${player.name}: ${x.caption}` : player.name}><Image src={x.src} alt={x.caption ? `${player.name}: ${x.caption}` : `${player.name} on the polo ground`} widths={[600, 1100]} sizes="(max-width: 820px) 100vw, 55vw" /></a>
            ))}
          </div>
        )}
      </div>
    </div>
    <div class="wrap">
      <nav class="pager" aria-label="Other players">
        {prev && <a href={`/team/${prev.id}/`}><small>Previous</small>{prev.position}. {prev.short}</a>}
        {next && <a class="next" href={`/team/${next.id}/`}><small>Next</small>{next.position}. {next.short}</a>}
      </nav>
    </div>
  </section>
  {(photo || extraItems.length > 0) && <Lightbox />}
</Base>
