---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
---
<Base title="Gallery" description="Photos and video from Chingkhei Hunba Polo Club.">
  <PageHeader title="Gallery" lede="Matches, practice and the ponies, in photos and video." />
  <Todo>Photos from the club’s archive and from match shoots. Only photos the club has approved, and with the consent of the players shown.</Todo>
  <div class="grid">
    {Array.from({ length: 6 }).map(() => <div class="placeholder-img">Photo</div>)}
  </div>
  <h2>Video</h2>
  <Todo>YouTube embeds once the club’s channel is set up.</Todo>
</Base>
