---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---
<Base title="Contact" description="Contact Chingkhei Hunba Polo Club, Kongpal, Imphal East.">
  <section class="page-head">
    <div class="wrap">
      <h1>Contact</h1>
      <p>For matches, riding, media or partnerships, get in touch with the club.</p>
    </div>
  </section>
  <section class="section section--sky">
    <div class="wrap split">
      <div class="contact-card">
        <strong>{site.name}</strong>
        <p>{site.address}</p>
        {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
        {site.phone && <p><a href={`tel:${site.phone.replaceAll(' ', '')}`}>{site.phone}</a></p>}
      </div>
      <div class="contact-card">
        <strong>Follow the club</strong>
        {site.social.instagram && <p><a href={site.social.instagram}>Instagram</a></p>}
        {site.social.facebook && <p><a href={site.social.facebook}>Facebook</a></p>}
      </div>
    </div>
  </section>
</Base>
