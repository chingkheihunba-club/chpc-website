---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import { site } from '../config';
---
<Base title="Contact" description="Contact Chingkhei Hunba Polo Club, Kongpal, Imphal East.">
  <PageHeader title="Contact" lede="Get in touch with the club." />
  <div class="card">
    <p><strong>{site.name}</strong><br />{site.address}</p>
    {site.email && <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>}
    {site.phone && <p>Phone: {site.phone}</p>}
  </div>
  <Todo>The club’s phone number, a contact person, and whether to show a map of Kongpal.</Todo>
</Base>
