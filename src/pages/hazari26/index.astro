---
import Base from '../../layouts/Base.astro';
import fixture from '../../data/tournaments/hazari-2026.json';
import { Draw, fmt, wd, wdl, type Tournament, type Match } from '../../lib/tournament';
import { site } from '../../config';
import { Image } from 'astro:assets';
import mhrpa from '../../assets/logos/mhrpa-logo.png';

// Tournament report, written after the final on 03-11-2026.
// While the tournament was on, this address showed live fixtures and results (scores came from
// /api/results). The final results are now in the JSON file, so this page is fully static.
// The update form at /hazari26/update/ still works, but saves there no longer change this page.
const t = fixture as Tournament;
const D = new Draw(t);
const club = t.club;
// Keep "Assam Rifles – A" together when a line wraps.
const nb = (name: string | null) => String(name ?? '').replace(/ – /g, '\u00a0–\u2060\u00a0');

const final = t.matches.find((x) => x.round === 'Final')!;
const fw = D.win(final)!;
const fl = fw === 'a' ? 'b' : 'a';
const champ = D.name(final[fw])!;
const runner = D.name(final[fl])!;
const champScore = fw === 'a' ? final.sa : final.sb;
const runnerScore = fw === 'a' ? final.sb : final.sa;

// Numbers for the "By the numbers" tiles, worked out from the results.
const played = t.matches.filter((x) => D.win(x));
const goals = played.reduce((s, x) => s + (x.sa ?? 0) + (x.sb ?? 0), 0);
const matchDays = new Set(played.map((x) => x.date)).size;
const margin = (x: Match) => Math.abs((x.sa ?? 0) - (x.sb ?? 0));
const biggest = [...played].sort((a, b) => margin(b) - margin(a) || a.id - b.id)[0];
const oneGoal = played.filter((x) => margin(x) === 1).length;

// One result line, winner first: "Team 5–3 Team".
function line(x: Match) {
  const w = D.win(x)!, l = w === 'a' ? 'b' : 'a';
  return { w: D.name(x[w])!, l: D.name(x[l])!, ws: w === 'a' ? x.sa : x.sb, ls: w === 'a' ? x.sb : x.sa };
}

// The knockout bracket, in draw order so each semi-final sits beside its two quarter-finals.
const bracket = [
  { label: 'Quarter-finals', ms: t.matches.filter((x) => x.round === 'Quarter-final') },
  { label: 'Semi-finals', ms: t.matches.filter((x) => x.round === 'Semi-final') },
  { label: 'Final', ms: [final] },
];

// All results, latest round first.
const rounds = ['Final', 'Semi-final', 'Quarter-final', 'Round 3', 'Round 2', 'Round 1'].map((r) => {
  const ms = t.matches.filter((x) => x.round === r).sort((a, b) => a.date.localeCompare(b.date) || a.id - b.id);
  const first = ms[0].date, last = ms[ms.length - 1].date;
  const label = r === 'Semi-final' ? 'Semi-finals' : r === 'Quarter-final' ? 'Quarter-finals' : r;
  return { r, label, ms, when: first === last ? `${wd(first)} ${fmt(first)}` : `${fmt(first)} to ${fmt(last)}` };
});
const knockout = (r: string) => ['Final', 'Semi-final', 'Quarter-final'].includes(r);
const where = (x: Match) => [`Match ${x.id}`, `${wd(x.date)} ${fmt(x.date)}`, x.ground ? `${x.ground} Ground` : x.place && x.place !== 'Final' ? x.place : ''].filter(Boolean).join(' · ');

const title = `${champ} win the N. Hazari & Dr. N. Tombi 2026`;
const description = `${champ} beat ${runner} ${champScore}–${runnerScore} in the final at Mapal Kangjeibung on ${fmt(final.date)} to win the ${t.name}. Report and all ${t.matches.length} results.`;
---
<Base title={title} description={description} image="/og/hazari-2026-champions.jpg">
  <article class="rp">
    <header class="rp-hero">
      <div class="wrap">
        <p class="rp-kicker"><span class="tag">Tournament report</span><span>{t.edition} · {t.organiser}</span></p>
        <h1><span class="nw">{nb(champ)}</span> <em>are champions</em></h1>
        <p class="rp-stand">{champ} beat {runner} {champScore}–{runnerScore} in the final at the {t.venue}, on {wdl(final.date)}, <span class="nw">{fmt(final.date)}</span>, to win the {t.name}.</p>
        <p class="rp-byline"><span>By <b>{site.name}</b></span><span>Published <b>{fmt(final.date)}</b></span><a href="#results">All {t.matches.length} results</a></p>
      </div>
    </header>

    <div class="wrap rp-board-wrap">
      <section class="rp-board" aria-label="The final">
        <p class="rp-board-meta"><span>Final · Match {final.id}</span><span>{wdl(final.date)} {fmt(final.date)} · Mapal Kangjeibung</span></p>
        <div class="rp-board-grid">
          <div class="rp-side win"><span class="lbl">Champions</span><span class="nm">{nb(champ)}</span></div>
          <span class="rp-num w" aria-hidden="true">{champScore}</span>
          <span class="rp-num dash" aria-hidden="true">–</span>
          <span class="rp-num l" aria-hidden="true">{runnerScore}</span>
          <div class="rp-side lose"><span class="lbl">Runners-up</span><span class="nm">{nb(runner)}</span></div>
          <p class="sr-only">{champ} {champScore}, {runner} {runnerScore}</p>
        </div>
      </section>
    </div>

    <div class="wrap rp-body">
      <aside class="rp-aside" aria-label="At a glance">
        <h2>At a glance</h2>
        <div class="rp-org"><Image src={mhrpa} alt="Manipur Horse Riding &amp; Polo Association logo" height={72} /><p><span>Organised by</span>{t.organiser}</p></div>
        <dl>
          <div><dt>Champions</dt><dd>{champ}</dd></div>
          <div><dt>Runners-up</dt><dd>{runner}</dd></div>
          <div><dt>Young Rising Polo Star</dt><dd>Moirangthem Chaoba, Luwangpokpa – A</dd></div>
          <div><dt>Dates</dt><dd>{fmt(t.start)} to {fmt(t.end)}</dd></div>
          <div><dt>Venue</dt><dd>{t.venue}</dd></div>
          <div><dt>Teams</dt><dd>{D.teams().length}</dd></div>
          <div><dt>Matches</dt><dd>{t.matches.length} over {matchDays} match days</dd></div>
          <div><dt>Chingkhei Hunba PC</dt><dd>Quarter-finals</dd></div>
        </dl>
      </aside>

      <div class="rp-article">
        <p class="rp-lede">The 39th N. Hazari &amp; Dr. N. Tombi State Polo Tournament ended on Tuesday, <span class="nw">03-11-2026</span>, at the Imphal Polo Ground, Mapal Kangjeibung. Assam Rifles – A won the final 5–3 against X – Polo Club and are this year’s champions. Congratulations to both teams, and to everyone who played over the three weeks.</p>

        <h2>The final</h2>
        <p>Both finalists began in the third round, and they reached the final in different ways. X – Polo Club scored 28 goals in three matches on the way: 8–2 against Ibudhou Thangjing – A, 14–4 against Tekcham PC in the quarter-final and 6–2 against MPSC – B in the semi-final. They were in this final as past champions too, having won the 34th edition in 2021.</p>
        <p>Assam Rifles – A came through closer games. They beat Paradise 4–1, then won their quarter-final 6–5 against MPSC – A and their semi-final 5–4 against Luwangpokpa – A. In the final they won by two goals, 5–3. They won all four of their matches, and none by more than three goals.</p>

        <h2>Young Rising Polo Star</h2>
        <p>Moirangthem Chaoba of Luwangpokpa – A received the Young Rising Polo Star certificate of excellence for his performance in the tournament. His team reached the semi-finals, beating Chingkhei Hunba PC 9–6 in the quarter-final before losing 5–4 to the champions. Congratulations to him.</p>

        <h2>The road to the final</h2>
        <figure class="rp-bracket" aria-label="Knockout rounds: quarter-finals, semi-finals and final">
          {bracket.map((col) => (
            <div class="rp-col">
              <p class="rp-col-h">{col.label}</p>
              <div class="rp-col-ms">
                {col.ms.map((x) => {
                  const w = D.win(x)!;
                  return (
                    <div class:list={['rp-bm', { final: x.round === 'Final' }]}>
                      <small>Match {x.id} · {fmt(x.date)}</small>
                      {(['a', 'b'] as const).map((s) => (
                        <div class:list={['ln', w === s ? 'win' : 'lose', { club: D.name(x[s]) === club }]}>
                          <span class="n">{nb(D.name(x[s]))}</span><span class="g">{s === 'a' ? x.sa : x.sb}</span>
                        </div>
                      ))}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </figure>

        <h2>Three weeks at Mapal Kangjeibung</h2>
        <p>{D.teams().length} teams entered, and {t.matches.length} matches were played over {matchDays} match days, starting with the opening match on Monday, <span class="nw">12-10-2026</span>. The tournament was organised by the Manipur Horse Riding &amp; Polo Association (MHRPA).</p>
        <p>Play paused for five days in the middle of the tournament. The MHRPA postponed the matches of 20 and 21 October and called off play on 22, 23 and 24 October. Play resumed on Sunday, <span class="nw">25-10-2026</span>, with the rest of the fixture in the same order. The semi-finals, first due on <span class="nw">31-10-2026</span>, were played on Sunday, <span class="nw">01-11-2026</span>, and the final two days later.</p>

        <div class="rp-stats">
          <div class="rp-stat"><b>{D.teams().length}</b><span>teams</span></div>
          <div class="rp-stat"><b>{t.matches.length}</b><span>matches</span></div>
          <div class="rp-stat"><b>{goals}</b><span>goals, about {Math.round(goals / played.length)} a match</span></div>
          <div class="rp-stat"><b>{oneGoal}</b><span>matches won by a single goal</span></div>
          <div class="rp-stat wide"><b>{line(biggest).ws}–{line(biggest).ls}</b><span>Biggest win: {line(biggest).w} over {line(biggest).l}, {biggest.round}, {fmt(biggest.date)}</span></div>
        </div>

        <h2>Chingkhei Hunba Polo Club</h2>
        <p>The club entered in the third round. On Tuesday, <span class="nw">27-10-2026</span>, the team beat Lamyanba Pakhang 17–3, the second-widest winning margin of the tournament. In the quarter-final on Friday, <span class="nw">30-10-2026</span>, the club lost 9–6 to Luwangpokpa – A, who went on to lose their semi-final 5–4 to the champions.</p>
        <h2>Thank you</h2>
        <p>Thank you to the MHRPA and its Technical Committee for running the tournament, to every team that took part, to the players, grooms and pony owners who keep the Manipuri pony on the ground, and to everyone who came to Mapal Kangjeibung or followed the matches on this page. The club’s next tournaments are on the <a href="/season/">Season page</a>.</p>

        <p class="rp-src">Sources: X – Polo Club’s 2021 title, <a href="https://www.nenow.in/north-east-news/x-polo-club-wangkhei-emerges-champion-polo-tournament.html" rel="noopener">Northeast Now, November 2021</a>. The Young Rising Polo Star award, as announced by Luwangpokpa Polo Club on Instagram, 03-11-2026.</p>
      </div>
    </div>

    <section class="section section--sky rp-results" id="results">
      <div class="wrap">
        <div class="section-head">
          <h2>All results</h2>
          <p>{t.matches.length} matches, latest round first. Winners in bold.</p>
        </div>
        {rounds.map((rd) => (
          <details class="rp-round" open={knockout(rd.r)}>
            <summary><span class="rp-round-h">{rd.label}</span><span class="rp-round-sub">{rd.ms.length} {rd.ms.length === 1 ? 'match' : 'matches'} · {rd.when}</span></summary>
            <ul class="rp-rows">
              {rd.ms.map((x) => {
                const w = D.win(x)!;
                return (
                  <li class:list={['rp-row', { club: D.involves(x, club) }]}>
                    <span class="meta">{where(x)}</span>
                    <span class:list={['t', w === 'a' ? 'win' : 'lose', { club: D.name(x.a) === club }]}>{nb(D.name(x.a))}</span>
                    <span class="s"><span class="sa">{x.sa}</span><span class="sd">–</span><span class="sb">{x.sb}</span></span>
                    <span class:list={['t', 'b', w === 'b' ? 'win' : 'lose', { club: D.name(x.b) === club }]}>{nb(D.name(x.b))}</span>
                  </li>
                );
              })}
            </ul>
          </details>
        ))}
        <div class="rp-notes">
          <p><b>Not the official record.</b> The results announced by the {t.organiser} are final. This page followed the tournament day by day while it was on, as a voluntary effort by {site.name} for players and polo lovers. If you spot a mistake, please <a href={site.social.instagram} target="_blank" rel="noopener">message the club on Instagram</a> or use the <a href="/contact/">contact page</a>, and it will be corrected.</p>
          {t.notes.map((n) => <p>{n}</p>)}
        </div>
      </div>
    </section>
  </article>
</Base>
