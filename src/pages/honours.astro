---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import { honours, type Honour } from '../data/honours';
const sorted = (sport: Honour['sport']) =>
  honours.filter((h) => h.sport === sport).sort((a, b) => b.sortKey.localeCompare(a.sortKey));
const sections = [
  { title: 'Polo', rows: sorted('polo') },
  { title: 'Equestrian', rows: sorted('equestrian') },
];
---
<Base title="Honours" description="Titles and results of Chingkhei Hunba Polo Club.">
  <PageHeader title="Honours" lede="Titles and finals since the club joined the state calendar in 1995." />
  <p class="muted">
    Each result shows where it comes from: a newspaper report (linked), or the club’s own record.
  </p>

  {sections.map((sec) => (
    <>
      <h2>{sec.title}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>When</th><th>Competition</th><th>Result</th><th>Detail</th><th>Source</th></tr>
          </thead>
          <tbody>
            {sec.rows.map((r) => (
              <tr>
                <td>{r.when}</td>
                <td>{r.event}</td>
                <td class="result">{r.result}</td>
                <td>{r.detail}</td>
                <td>
                  {r.source?.url
                    ? <a href={r.source.url} rel="noopener">{r.source.label}</a>
                    : <span class="club-src">{r.source?.label ?? 'Club record'}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}

  <Todo>The list is not complete. The club’s trophies, photographs and certificates will fill the gaps. Also: which equestrian championship the 2011–2018 titles belong to, and any reports or photos of the 2006 Governor’s Cup and the 2016 state title.</Todo>
</Base>
