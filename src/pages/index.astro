---
import Base from '../layouts/Base.astro';
import Jersey from '../components/Jersey.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image, getImage } from 'astro:assets';
import { players } from '../data/players';
import { media } from '../data/media';
import { getCollection } from 'astro:content';
import { photos } from '../data/gallery';
import heroPhoto from '../assets/photos/2018-03-governors-cup-play.jpg';
import gcTeams from '../assets/photos/2026-02-governors-cup-men-and-women.jpg';

const squad = players.filter((p) => p.show).sort((a, b) => Number(a.position) - Number(b.position));
// Newest approved club post; on the same date, the one with the earlier file name wins.
const latest = (await getCollection('news', ({ data }) => data.approved)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id))[0];
const press = [...media].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const picks = await Promise.all(
  photos.slice(0, 6).map(async (p) => ({ ...p, full: await getImage({ src: p.src, width: Math.min(p.src.width, 1600), format: 'webp' }) })),
);
---
<Base>
  <section class="hero">
    <div class="hero-photo"><Image src={heroPhoto} alt="" widths={[960]} loading="eager" /></div>
    <div class="wrap">
      <h1><span>Chingkhei</span><span>Hunba</span><span class="red">Polo Club</span></h1>
      <div class="hero-foot">
        <p>Polo and horsemanship from Kongpal, Imphal East, since 1995. Governor’s Cup champions, men and women, 2026.</p>
        <div class="btns">
          <a class="btn" href="/team/">Meet the team</a>
          <a class="btn btn--ghost" href="/club/">About the club</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>The 2026–27 team</h2>
        <p>Six players carry the club’s name this season. Tap a jersey to meet him.</p>
      </div>
      <div class="squad">
        {squad.map((p) => <Jersey player={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap double">
      <div>
        <h2>Two finals, one afternoon</h2>
        <p class="lede" style="color: rgba(255,255,255,.8)">
          On 28 February 2026 at Mapal Kangjeibung, the club played both Governor’s Cup finals and won them both.
          The women came back from 2–2 with three goals in the last chukker. The men turned the tables on the side
          that had beaten them a fortnight earlier.
        </p>
        <div class="scores">
        <div>
          <div class="score">
            <span class="side">Chingkhei Hunba<small>Women</small></span>
            <span class="nums"><b>6</b>–2</span>
            <span class="side">Assam Rifles<small>Women’s Polo Team</small></span>
          </div>
          <p class="score-cap">21st Governor’s Cup Women’s Polo Tournament, final</p>
        </div>
        <div>
          <div class="score">
            <span class="side">Chingkhei Hunba<small>Men</small></span>
            <span class="nums"><b>7</b>–6</span>
            <span class="side">X-Polo Club<small>Wangkhei</small></span>
          </div>
          <p class="score-cap">32nd Governor’s Cup Invitation Polo Tournament, final</p>
        </div>
        </div>
        <a class="text-link" href="/club/#honours">See the club’s honours</a>
      </div>
      <figure class="double-photo">
        <Image src={gcTeams} alt="The club’s men’s and women’s sides with both Governor’s Cup trophies at Mapal Kangjeibung." widths={[480, 960]} sizes="(max-width: 860px) 100vw, 45vw" />
        <figcaption>Both sides with both trophies, 28-02-2026.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--sky">
    <div class="wrap">
      <div class="section-head"><h2>More than a polo club</h2></div>
      <div class="facts">
        <div class="fact">
          <span class="big">1995</span>
          <p>Started by Th. Thoinu, Thongam Jotin, Th. Kaoba and M. Bidyananda, out of a love for ponies. The name means “Rising Sun”.</p>
        </div>
        <div class="fact">
          <span class="big">~100</span>
          <p>Manipuri ponies kept by the club today, grown from one pony, Nongshaba, bought in 1996 with the members’ own money.</p>
        </div>
        <div class="fact">
          <span class="big">4 sides</span>
          <p>Men’s A, B and C sides have played in the same tournament, and the club fields a women’s side too. Its riders also compete in show jumping, tent pegging and arambai.</p>
        </div>
      </div>
      <blockquote class="quote">
        <p>“The Manipuri pony is not just an animal, but a living piece of global history that is currently fighting for survival.”</p>
        <cite>Chingkhei Hunba Polo Club</cite>
      </blockquote>
    </div>
  </section>

  {latest && (
    <section class="section">
      <div class="wrap">
        <a class="feature" href={`/news/${latest.id}/`}>
          {latest.data.photos[0] && <Image src={latest.data.photos[(latest.data.cover ?? 1) - 1] ?? latest.data.photos[0]} alt="" widths={[600, 1000]} sizes="(max-width: 860px) 100vw, 50vw" />}
          <div>
            <span class="feature-tag">From the club</span>
            <h2>{latest.data.title}</h2>
            <p>{latest.data.summary}</p>
            <span class="text-link">Read the story</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class:list={['section', { 'section--sky': latest }]}>
    <div class="wrap">
      <div class="section-head">
        <h2>In the papers</h2>
        <a class="text-link" href="/news/">All news and press</a>
      </div>
      <ul class="press">
        {press.map((m) => (
          <li>
            <div class="src">{m.outlet}<time>{m.when}</time></div>
            <div>
              <h3><a href={m.url} rel="noopener" target="_blank">{m.title}</a></h3>
              <p>{m.brief}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--sky">
    <div class="wrap">
      <div class="section-head">
        <h2>From the ground</h2>
        <a class="text-link" href="/gallery/">All photos</a>
      </div>
      <div class="photos" data-lightbox>
        {picks.map((p, i) => (
          <a href={p.full.src} data-caption={p.caption} data-when={p.when}>
            <Image src={p.src} alt={p.alt} widths={[480, 960]} sizes="(max-width: 700px) 100vw, 60vw" loading={i < 2 ? 'eager' : 'lazy'} />
          </a>
        ))}
      </div>
    </div>
  </section>
  <Lightbox />
</Base>
