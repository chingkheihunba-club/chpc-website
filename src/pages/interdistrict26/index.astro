---
import Base from '../../layouts/Base.astro';
import fixture from '../../data/tournaments/interdistrict-2026.json';
import { Draw, fmt, wd, wdl, type Tournament, type Match } from '../../lib/tournament';
import { site } from '../../config';
import { Image } from 'astro:assets';
import mhrpa from '../../assets/logos/mhrpa-logo.png';

// Tournament report, written after the final on 17-11-2026 (published 25-11-2026).
// While the tournament was on, this address showed live fixtures and results (scores came from
// /api/results). The final results are now in the JSON file, so this page is fully static.
// The update form at /interdistrict26/update/ still works, but saves there no longer change this page.
const t = fixture as Tournament;
const D = new Draw(t);
const club = t.club;
// Keep "MPSC – B" together when a line wraps.
const nb = (name: string | null) => String(name ?? '').replace(/ – /g, ' –⁠ ');
// Which district each team played for.
const district = (name: string | null) => t.groups?.find((g) => g.teams.includes(String(name)))?.name ?? '';

const final = t.matches.find((x) => x.round === 'Final')!;
const fw = D.win(final)!;
const fl = fw === 'a' ? 'b' : 'a';
const champ = D.name(final[fw])!;
const runner = D.name(final[fl])!;
const champScore = fw === 'a' ? final.sa : final.sb;
const runnerScore = fw === 'a' ? final.sb : final.sa;

// Numbers for the "By the numbers" tiles, worked out from the results.
const played = t.matches.filter((x) => D.win(x));
const goals = played.reduce((s, x) => s + (x.sa ?? 0) + (x.sb ?? 0), 0);
const matchDays = new Set(played.map((x) => x.date)).size;
const margin = (x: Match) => Math.abs((x.sa ?? 0) - (x.sb ?? 0));
const biggest = [...played].sort((a, b) => margin(b) - margin(a) || a.id - b.id)[0];
const oneGoal = played.filter((x) => margin(x) === 1).length;

// One result line, winner first: "Team 5–3 Team".
function line(x: Match) {
  const w = D.win(x)!, l = w === 'a' ? 'b' : 'a';
  return { w: D.name(x[w])!, l: D.name(x[l])!, ws: w === 'a' ? x.sa : x.sb, ls: w === 'a' ? x.sb : x.sa };
}

// The knockout bracket, in draw order so each semi-final sits beside its two quarter-finals.
const bracket = [
  { label: 'Quarter-finals', ms: t.matches.filter((x) => x.round === 'Quarter-final') },
  { label: 'Semi-finals', ms: t.matches.filter((x) => x.round === 'Semi-final') },
  { label: 'Final', ms: [final] },
];

// All results, latest round first.
const rounds = ['Final', 'Semi-final', 'Quarter-final', 'Round 1'].map((r) => {
  const ms = t.matches.filter((x) => x.round === r).sort((a, b) => a.date.localeCompare(b.date) || a.id - b.id);
  const first = ms[0].date, last = ms[ms.length - 1].date;
  const label = r === 'Semi-final' ? 'Semi-finals' : r === 'Quarter-final' ? 'Quarter-finals' : r;
  return { r, label, ms, when: first === last ? `${wd(first)} ${fmt(first)}` : `${fmt(first)} to ${fmt(last)}` };
});
const knockout = (r: string) => ['Final', 'Semi-final', 'Quarter-final'].includes(r);
const where = (x: Match) => [`Match ${x.id}`, `${wd(x.date)} ${fmt(x.date)}`, x.ground ? `${x.ground} Ground` : x.place && x.place !== 'Final' ? x.place : ''].filter(Boolean).join(' · ');

const published = '2026-11-25';
const title = `${champ} win the Dr. Ksh. Chourjit Singh Inter District 2026`;
const description = `${champ} beat ${runner} ${champScore}–${runnerScore} in the final at Mapal Kangjeibung on ${fmt(final.date)} to win the ${t.name}. Report and all ${t.matches.length} results.`;
---
<Base title={title} description={description} image="/og/interdistrict-2026-champions.jpg">
  <article class="rp">
    <header class="rp-hero">
      <div class="wrap">
        <p class="rp-kicker"><span class="tag">Tournament report</span><span>{t.edition} · {t.organiser}</span></p>
        <h1><span class="nw">{nb(champ)}</span> <em>are champions</em></h1>
        <p class="rp-stand">{champ} beat {runner} {champScore}–{runnerScore} in the final at the {t.venue}, on {wdl(final.date)}, <span class="nw">{fmt(final.date)}</span>, to win the {t.name}.</p>
        <p class="rp-byline"><span>By <b>{site.name}</b></span><span>Published <b>{fmt(published)}</b></span><a href="#results">All {t.matches.length} results</a></p>
      </div>
    </header>

    <div class="wrap rp-board-wrap">
      <section class="rp-board" aria-label="The final">
        <p class="rp-board-meta"><span>Final · Match {final.id}</span><span>{wdl(final.date)} {fmt(final.date)} · Mapal Kangjeibung</span></p>
        <div class="rp-board-grid">
          <div class="rp-side win"><span class="lbl">Champions</span><span class="nm">{nb(champ)}</span></div>
          <span class="rp-num w" aria-hidden="true">{champScore}</span>
          <span class="rp-num dash" aria-hidden="true">–</span>
          <span class="rp-num l" aria-hidden="true">{runnerScore}</span>
          <div class="rp-side lose"><span class="lbl">Runners-up</span><span class="nm">{nb(runner)}</span></div>
          <p class="sr-only">{champ} {champScore}, {runner} {runnerScore}</p>
        </div>
      </section>
    </div>

    <div class="wrap rp-body">
      <aside class="rp-aside" aria-label="At a glance">
        <h2>At a glance</h2>
        <div class="rp-org"><Image src={mhrpa} alt="Manipur Horse Riding &amp; Polo Association logo" height={72} /><p><span>Organised by</span>{t.organiser}</p></div>
        <dl>
          <div><dt>Champions</dt><dd>{champ}, {district(champ)}</dd></div>
          <div><dt>Runners-up</dt><dd>{runner}, {district(runner)}</dd></div>
          <div><dt>Dates</dt><dd>{fmt(t.start)} to {fmt(t.end)}</dd></div>
          <div><dt>Venue</dt><dd>{t.venue}</dd></div>
          <div><dt>Teams</dt><dd>{D.teams().length}, from five districts and the forces</dd></div>
          <div><dt>Matches</dt><dd>{t.matches.length} over {matchDays} match days</dd></div>
          <div><dt>Chingkhei Hunba PC</dt><dd>Quarter-finals, playing for {district(club)}</dd></div>
        </dl>
      </aside>

      <div class="rp-article">
        <p class="rp-lede">The 3rd Dr. Ksh. Chourjit Singh Inter District Polo Tournament ended on Tuesday, <span class="nw">17-11-2026</span>, at the Imphal Polo Ground, Mapal Kangjeibung. X-Polo Club, playing for Imphal East, won the final 5–3 against Thangmeiband Youth PC of Imphal West, and are this year’s champions. Congratulations to both teams, and to every player who took part.</p>

        <h2>The final</h2>
        <p>X-Polo Club began in the quarter-finals. They beat Chingkhei Hunba PC 5–1 on <span class="nw">12-11-2026</span>, then MPSC – B 9–5 in the 1st Semi-final two days later. In the final they scored first, in the opening chukker. Thangmeiband Youth PC replied with two goals, but X-Polo Club finished <span class="nw">5–3</span> winners.</p>
        <p>It is their second Inter District title in a row: X-Polo Club also won the 2nd edition in February 2026, beating Chingkhei Hunba PC in that final. A fortnight before this final, they had been runners-up in the <a href="/hazari26/">N. Hazari &amp; Dr. N. Tombi State Polo</a>, losing 5–3 to Assam Rifles – A.</p>
        <p>Thangmeiband Youth PC played four matches to reach the final. They beat Southern PC 11–0 in the first round, Assam Rifles 7–4 in the quarter-final, and Luwangpokpa PC 6–5 in the 2nd Semi-final, the only match of the tournament won by a single goal. That semi-final was put back a day, from 14-11 to <span class="nw">15-11-2026</span>, and the final moved with it, from 16-11 to <span class="nw">17-11-2026</span>.</p>

        <h2>The road to the final</h2>
        <figure class="rp-bracket" aria-label="Knockout rounds: quarter-finals, semi-finals and final">
          {bracket.map((col) => (
            <div class="rp-col">
              <p class="rp-col-h">{col.label}</p>
              <div class="rp-col-ms">
                {col.ms.map((x) => {
                  const w = D.win(x)!;
                  return (
                    <div class:list={['rp-bm', { final: x.round === 'Final' }]}>
                      <small>Match {x.id} · {fmt(x.date)}</small>
                      {(['a', 'b'] as const).map((s) => (
                        <div class:list={['ln', w === s ? 'win' : 'lose', { club: D.name(x[s]) === club }]}>
                          <span class="n">{nb(D.name(x[s]))}</span><span class="g">{s === 'a' ? x.sa : x.sb}</span>
                        </div>
                      ))}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </figure>

        <h2>Twelve teams, by district</h2>
        <p>The Inter District brings teams together by district. This year {D.teams().length} teams took part: two each from Imphal West, Imphal East, Thoubal, Kakching and Bishnupur districts, and two from the forces. {t.groupsNote} The tournament was organised by the Manipur Horse Riding &amp; Polo Association (MHRPA).</p>
        <ul class="rp-districts">
          {t.groups!.map((g) => <li><b>{g.name}</b>{g.teams.map((x, i) => <>{i ? ' · ' : ''}<span class:list={{ 'rp-champ': x === champ }}>{nb(x)}</span></>)}</li>)}
        </ul>
        <p>{t.matches.length} matches were played over {matchDays} match days, starting with the opening match on Sunday, <span class="nw">08-11-2026</span>. The four first-round winners joined four teams that started in the quarter-finals.</p>

        <div class="rp-stats">
          <div class="rp-stat"><b>{D.teams().length}</b><span>teams</span></div>
          <div class="rp-stat"><b>{t.matches.length}</b><span>matches</span></div>
          <div class="rp-stat"><b>{goals}</b><span>goals, about {Math.round(goals / played.length)} a match</span></div>
          <div class="rp-stat"><b>{oneGoal}</b><span>{oneGoal === 1 ? 'match' : 'matches'} won by a single goal</span></div>
          <div class="rp-stat wide"><b>{line(biggest).ws}–{line(biggest).ls}</b><span>Biggest win: {line(biggest).w} over {line(biggest).l}, {biggest.round}, {fmt(biggest.date)}</span></div>
        </div>

        <h2>Chingkhei Hunba Polo Club</h2>
        <p>Playing for Kakching District, the club opened the tournament on Sunday, <span class="nw">08-11-2026</span>, and beat Loyalakpa PC 8–5. In the quarter-final on Thursday, <span class="nw">12-11-2026</span>, the club lost 5–1 to X-Polo Club, who went on to win the title.</p>
        <p>The club is back at Mapal Kangjeibung for the 33rd Governor’s Cup Invitation Polo Tournament, which began on <span class="nw">25-11-2026</span>. Fixtures and results are on the <a href="/governorscup26/">Governor’s Cup page</a>.</p>

        <h2>Thank you</h2>
        <p>Thank you to the MHRPA and its Tournament Committee for running the tournament, to every team that took part, to the players, grooms and pony owners who keep the Manipuri pony on the ground, and to everyone who came to Mapal Kangjeibung or followed the matches on this page. The club’s next tournaments are on the <a href="/season/">Season page</a>.</p>

        <p class="rp-src">Sources: the final, <a href="https://www.uniindia.com/east-india/sports-manipur-polo-trophy/248809" rel="noopener">UNI, 17-11-2026</a>. X-Polo Club and Chingkhei Hunba PC in the February 2026 final, <a href="https://www.lokmattimes.com/national/manipur-to-develop-world-class-polo-ground-in-imphal-cm-khemchand-singh/amp/" rel="noopener">IANS, 14-02-2026</a>, and the club’s own <a href="/news/governors-cup-2026-men-women-champions/">Governor’s Cup post</a>. Fixture and teams from the MHRPA notice of 05-11-2026 and its fixture.</p>
      </div>
    </div>

    <section class="section section--sky rp-results" id="results">
      <div class="wrap">
        <div class="section-head">
          <h2>All results</h2>
          <p>{t.matches.length} matches, latest round first. Winners in bold.</p>
        </div>
        {rounds.map((rd) => (
          <details class="rp-round" open={knockout(rd.r)}>
            <summary><span class="rp-round-h">{rd.label}</span><span class="rp-round-sub">{rd.ms.length} {rd.ms.length === 1 ? 'match' : 'matches'} · {rd.when}</span></summary>
            <ul class="rp-rows">
              {rd.ms.map((x) => {
                const w = D.win(x)!;
                return (
                  <li class:list={['rp-row', { club: D.involves(x, club) }]}>
                    <span class="meta">{where(x)}</span>
                    <span class:list={['t', w === 'a' ? 'win' : 'lose', { club: D.name(x.a) === club }]}>{nb(D.name(x.a))}</span>
                    <span class="s"><span class="sa">{x.sa}</span><span class="sd">–</span><span class="sb">{x.sb}</span></span>
                    <span class:list={['t', 'b', w === 'b' ? 'win' : 'lose', { club: D.name(x.b) === club }]}>{nb(D.name(x.b))}</span>
                  </li>
                );
              })}
            </ul>
          </details>
        ))}
        <div class="rp-notes">
          <p><b>Not the official record.</b> The results announced by the {t.organiser} are final. This page followed the tournament day by day while it was on, as a voluntary effort by {site.name} for players and polo lovers. If you spot a mistake, please <a href={site.social.instagram} target="_blank" rel="noopener">message the club on Instagram</a> or use the <a href="/contact/">contact page</a>, and it will be corrected.</p>
          {t.notes.map((n) => <p>{n}</p>)}
        </div>
      </div>
    </section>
  </article>
</Base>
