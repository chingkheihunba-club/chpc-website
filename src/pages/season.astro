---
import Base from '../layouts/Base.astro';
import { season } from '../data/season';
---
<Base title="Season" description={`Chingkhei Hunba Polo Club, ${season.label} season.`}>
  <section class="page-head">
    <div class="wrap">
      <h1>Season {season.label}</h1>
      <p>The tournaments the club plans to play from October to April. Dates go up as the associations announce them.</p>
    </div>
  </section>
  <section class="section section--sky">
    <div class="wrap">
      <ul class="fixtures">
        {season.fixtures.map((f) => (
          <li>
            <span class="t">{f.tournament}</span>
            <span class:list={['d', { set: f.dates }]}>{f.dates || 'Dates to be announced'}{f.venue && `, ${f.venue}`}{f.result && `. ${f.result}`}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
