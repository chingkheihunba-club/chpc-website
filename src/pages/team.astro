---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { players, expected } from '../data/players';
import { season } from '../data/season';

// Player photos: src/assets/players/<id>.jpg (or .jpeg/.png/.webp), picked up automatically.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/players/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photoFor = (id: string) => {
  const hit = Object.entries(photoFiles).find(([path]) =>
    path.split('/').pop()!.replace(/\.[^.]+$/, '').toLowerCase() === id,
  );
  return hit?.[1].default;
};
const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();

const squad = players.filter((p) => p.show);
---
<Base title="Team" description={`The Chingkhei Hunba Polo Club team for the ${season.label} season.`}>
  <PageHeader title="Team" lede={`The six players carrying the club’s name through the ${season.label} season.`} />

  <div class="squad">
    {squad.map((p) => {
      const photo = photoFor(p.id);
      const missing = expected.filter((f) => !p[f.key]).map((f) => f.label);
      const social = [
        p.social.instagram && { label: 'Instagram', href: p.social.instagram },
        p.social.facebook && { label: 'Facebook', href: p.social.facebook },
        p.social.youtube && { label: 'YouTube', href: p.social.youtube },
      ].filter(Boolean) as { label: string; href: string }[];
      return (
        <article class="player" id={p.id}>
          {photo
            ? <Image class="player-photo" src={photo} alt={p.name} width={640} />
            : <div class="player-photo initials" aria-hidden="true">{initials(p.name)}</div>}
          <div class="player-body">
            <h3>{p.name}</h3>
            {p.pressName && <p class="press-name">In match reports: {p.pressName}</p>}

            <dl class="facts">
              {p.position && <><dt>Position</dt><dd>{p.position}</dd></>}
              {p.withClubSince && <><dt>With the club</dt><dd>Since {p.withClubSince}</dd></>}
              {p.pony && <><dt>Pony</dt><dd>{p.pony}</dd></>}
              {p.alsoRides && <><dt>Also</dt><dd>{p.alsoRides}</dd></>}
            </dl>

            {p.inTheirWords && <blockquote>“{p.inTheirWords}”</blockquote>}

            {p.highlights.length > 0 && (
              <>
                <h4>Highlights</h4>
                <ul class="highlights">
                  {p.highlights.map((h) => (
                    <li>
                      {h.text}.{' '}
                      {h.source.url
                        ? <a class="src" href={h.source.url} rel="noopener">{h.source.label}</a>
                        : <span class="src">{h.source.label}</span>}
                    </li>
                  ))}
                </ul>
              </>
            )}

            {social.length > 0 && (
              <p class="player-social">
                {social.map((s) => <a href={s.href} rel="noopener">{s.label}</a>)}
              </p>
            )}

            {missing.length > 0 && (
              <Todo label="Still to come">{`From ${p.short}: ${missing.join(', ')}${photo ? '' : ', photo'}.`}</Todo>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <Todo label="Before launch">Each player sees his own profile and is happy with it. Results a player has listed but that we haven’t been able to check against a report or the club’s records stay off until the club confirms them.</Todo>
</Base>
