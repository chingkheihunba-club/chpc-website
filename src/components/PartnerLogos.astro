---
import { Image } from 'astro:assets';
import eartheners from '../assets/logos/eartheners-logo-notag.png';
import unibrow from '../assets/logos/unibrow-logo.png';

// Footer strip. Eartheners uses the no-tagline version at this size (brand guide:
// tagline version only where the tagline is readable). Add further partners here.
const partners = [
  { name: 'Eartheners', href: 'https://earthene.rs', logo: eartheners },
  { name: 'Unibrow Studio', href: '/partners/', logo: unibrow },
];
---
<div class="partner-logos">
  {partners.map((p) => (
    <a class="logo-tile" href={p.href} title={p.name}>
      <Image src={p.logo} alt={p.name} height={128} />
    </a>
  ))}
</div>
