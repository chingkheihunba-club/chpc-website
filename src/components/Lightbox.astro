---
// Full-screen photo viewer for any link inside an element marked `data-lightbox`.
// Each link points at the large image and carries `data-caption` (and optionally `data-when`).
// Close: Esc, the × button, or a click/tap outside the photo. Move: ← → keys, the arrow
// buttons, or a swipe. Without JavaScript the links still open the large image.
---
<dialog class="lb" aria-label="Photo viewer">
  <div class="lb-stage">
    <img class="lb-img" alt="" />
    <p class="lb-cap"><span class="lb-when"></span><span class="lb-text"></span></p>
  </div>
  <button class="lb-btn lb-close" type="button" aria-label="Close">×</button>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">‹</button>
  <button class="lb-btn lb-next" type="button" aria-label="Next photo">›</button>
  <p class="lb-count" aria-live="polite"></p>
</dialog>

<style is:global>
  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
        background: rgba(8, 12, 20, .97); color: #fff; overflow: hidden; }
  .lb::backdrop { background: rgba(8, 12, 20, .6); }
  .lb[open] { display: grid; place-items: center; animation: lb-in .18s ease-out; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
  .lb-stage { display: flex; flex-direction: column; align-items: center; gap: .9rem; max-width: min(92vw, 1400px);
              padding: 3.5rem 1rem 3rem; }
  .lb-img { max-width: 100%; max-height: calc(100dvh - 10rem); object-fit: contain; border-radius: 4px;
            box-shadow: 0 20px 60px rgba(0,0,0,.5); user-select: none; -webkit-user-drag: none;
            transition: opacity .15s; }
  .lb-img.is-loading { opacity: .25; }
  .lb-cap { margin: 0; max-width: 70ch; text-align: center; font-size: .95rem; line-height: 1.5; color: rgba(255,255,255,.88); }
  .lb-when { display: block; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; opacity: .65; margin-bottom: .15rem; }
  .lb-when:empty { display: none; }
  .lb-btn { position: absolute; display: grid; place-items: center; width: 3rem; height: 3rem; border: 0;
            border-radius: 999px; background: rgba(255,255,255,.12); color: #fff; font-size: 2rem; line-height: 1;
            cursor: pointer; transition: background .15s; backdrop-filter: blur(6px); }
  .lb-btn:hover, .lb-btn:focus-visible { background: rgba(255,255,255,.26); outline: none; }
  .lb-close { top: 1rem; right: 1rem; font-size: 1.8rem; }
  .lb-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-count { position: absolute; top: 1.6rem; left: 1.25rem; margin: 0; font-size: .8rem; letter-spacing: .1em; opacity: .7; }
  .lb.single .lb-prev, .lb.single .lb-next, .lb.single .lb-count { display: none; }
  @media (max-width: 640px) {
    .lb-prev, .lb-next { top: auto; bottom: 1rem; transform: none; width: 2.6rem; height: 2.6rem; }
    .lb-stage { padding-bottom: 4.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .lb[open] { animation: none; } }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lb');
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>('.lb-img')!;
    const when = dlg.querySelector<HTMLElement>('.lb-when')!;
    const text = dlg.querySelector<HTMLElement>('.lb-text')!;
    const count = dlg.querySelector<HTMLElement>('.lb-count')!;
    let links: HTMLAnchorElement[] = [];
    let i = 0;

    const show = (n: number) => {
      i = (n + links.length) % links.length;
      const a = links[i];
      img.classList.add('is-loading');
      img.onload = () => img.classList.remove('is-loading');
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      when.textContent = a.dataset.when ?? '';
      text.textContent = a.dataset.caption ?? '';
      count.textContent = `${i + 1} / ${links.length}`;
      // Warm the next photo so arrowing through feels instant.
      const next = links[(i + 1) % links.length];
      if (next) new Image().src = next.href;
    };

    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((group) => {
      const groupLinks = Array.from(group.querySelectorAll<HTMLAnchorElement>('a[href]'));
      groupLinks.forEach((a, n) => {
        a.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey) return; // let people open in a new tab
          e.preventDefault();
          links = groupLinks;
          dlg.classList.toggle('single', links.length < 2);
          show(n);
          dlg.showModal();
          document.documentElement.style.overflow = 'hidden';
        });
      });
    });

    dlg.addEventListener('close', () => { document.documentElement.style.overflow = ''; img.removeAttribute('src'); });
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', (e) => { e.stopPropagation(); show(i - 1); });
    dlg.querySelector('.lb-next')!.addEventListener('click', (e) => { e.stopPropagation(); show(i + 1); });
    // Click anywhere that isn't the photo or a button closes the viewer.
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === img || t.closest('.lb-btn') || t.closest('.lb-cap')) return;
      dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    // Swipe left/right on touch screens.
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(dx < 0 ? i + 1 : i - 1);
      x0 = null;
    });
  }
</script>
