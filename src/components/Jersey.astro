---
// A player as the back of his jersey: short name across the shoulders, big number.
// If a photo named after the player's id is in src/assets/players/, it sits behind the number.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { playerSlug, type Player } from '../data/players';

interface Props { player: Player }
const { player } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/players/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.entries(photos).find(([p]) => p.split('/').pop()!.split('.')[0] === player.id)?.[1].default;
---
<a class:list={['jersey', { 'has-photo': photo }]} href={`/team/${playerSlug(player)}/`} aria-label={`${player.name}, number ${player.position}`}>
  {photo && <div class="photo"><Image src={photo} alt="" widths={[400, 700]} sizes="(max-width: 760px) 68vw, 380px" style={`transform-origin: ${player.photoFocus ?? '50% 25%'}; transform: scale(${player.photoZoom ?? 1.45})`} /></div>}
  <span class="jersey-name">{player.jerseyName ?? player.short}</span>
  <span class="jersey-num" aria-hidden="true">{player.position}</span>
  <span class="jersey-full">{player.name}</span>
</a>
